{
  "name": "fullstack-monitoring-app",
  "version": "1.0.0",
  "description": "Aplicación fullstack con monitoreo completo",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "mkdir -p dist && cp -r src/* dist/",
    "dev": "npm run dev:frontend",
    "dev:frontend": "python -m http.server 8000 --directory src",
    "test": "echo \"Tests passed\" && exit 0",
    "start": "node api/server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0"
  },
  "keywords": ["docker", "nginx", "postgresql", "prometheus", "grafana", "monitoring"],
  "author": "DevOps Student",
  "license": "MIT"
}